{
  "crons": [
    { "path": "/api/pluggy-sync", "schedule": "0 8 * * *" },
    { "path": "/api/keepalive", "schedule": "0 9 * * *" },
    { "path": "/api/briefing", "schedule": "0 10 * * *" },
    { "path": "/api/pluggy-sync", "schedule": "0 23 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
